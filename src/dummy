import React, { useState } from "react";
import { motion, AnimatePresence } from "framer-motion";
import { ArrowLeft, ArrowRight, Star } from "lucide-react";

export default function ReviewCarousel() {
  // Default reviews
  const defaultReviews = [
    {
      name: "Alex Carter",
      text: "This blog consistently delivers high-quality content on AI, cloud, and tech trends. Love the clarity!",
      rating: 5,
    },
    {
      name: "Priya Sharma",
      text: "I found the Edge AI article incredibly helpful for my IoT project. Keep posting such insightful topics!",
      rating: 4,
    },
    {
      name: "Michael Lopez",
      text: "The UI is sleek and the explanations are simple. Great work on maintaining both style and substance.",
      rating: 5,
    },
  ];

  const [reviews, setReviews] = useState(defaultReviews);
  const [current, setCurrent] = useState(0);
  const [newReview, setNewReview] = useState({ name: "", text: "", rating: 5 });
  const [showForm, setShowForm] = useState(false);

  // Navigate carousel
  const nextReview = () => setCurrent((prev) => (prev + 1) % reviews.length);
  const prevReview = () =>
    setCurrent((prev) => (prev - 1 + reviews.length) % reviews.length);

  // Add new review
  const handleSubmit = (e) => {
    e.preventDefault();
    if (!newReview.name.trim() || !newReview.text.trim()) return;
    setReviews([...reviews, newReview]);
    setNewReview({ name: "", text: "", rating: 5 });
    setShowForm(false);
    setCurrent(reviews.length); // show newly added review
  };

  return (
    <section className="review-carousel-section">
      <h2 className="carousel-title">
        Reader <span>Reviews</span>
      </h2>

      <div className="carousel-container">
        <button className="nav-btn left" onClick={prevReview}>
          <ArrowLeft size={24} />
        </button>

        <AnimatePresence mode="wait">
          <motion.div
            key={current}
            className="review-card"
            initial={{ opacity: 0, x: 60 }}
            animate={{ opacity: 1, x: 0 }}
            exit={{ opacity: 0, x: -60 }}
            transition={{ duration: 0.5 }}
          >
            <div className="review-stars">
              {[...Array(reviews[current].rating)].map((_, i) => (
                <Star key={i} size={20} color="#f84b4b" fill="#f84b4b" />
              ))}
            </div>
            <p className="review-text">“{reviews[current].text}”</p>
            <h4 className="review-author">– {reviews[current].name}</h4>
          </motion.div>
        </AnimatePresence>

        <button className="nav-btn right" onClick={nextReview}>
          <ArrowRight size={24} />
        </button>
      </div>

      <button className="add-review-btn" onClick={() => setShowForm(!showForm)}>
        {showForm ? "Cancel" : "Add Your Review"}
      </button>

      {showForm && (
        <form className="review-form" onSubmit={handleSubmit}>
          <input
            type="text"
            placeholder="Your Name"
            value={newReview.name}
            onChange={(e) =>
              setNewReview({ ...newReview, name: e.target.value })
            }
            required
          />
          <textarea
            placeholder="Your Review"
            value={newReview.text}
            onChange={(e) =>
              setNewReview({ ...newReview, text: e.target.value })
            }
            required
          ></textarea>
          <label>
            Rating:
            <select
              value={newReview.rating}
              onChange={(e) =>
                setNewReview({ ...newReview, rating: parseInt(e.target.value) })
              }
            >
              {[1, 2, 3, 4, 5].map((r) => (
                <option key={r} value={r}>
                  {r}
                </option>
              ))}
            </select>
          </label>
          <button type="submit">Submit Review</button>
        </form>
      )}
    </section>
  );
}
