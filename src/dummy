/* ========================================================== */
/* !!! GLOBAL/COMMON STYLES CONSOLIDATION !!! */
/* ========================================================== */
:root {
  /* Colors */
  --primary-color: #f84b4b;
  --text-dark: #333333;
  --text-light: #666666;
  --text-inside-orange: white;
  --background-light: #f5f5f5;
  --background-white: #ffffff;
  --footer-bg: black;
  --footer-text: #ecf0f1;
  --border-color: #f84b4b; /* Darker Orange for borders/accents */
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html,
body {
  width: 100%;
  min-height: 100vh;
  font-family: "Poppins", sans-serif;
  scroll-behavior: smooth;
  background-color: var(--background-light);
  color: var(--text-dark);
}

.highlight {
  color: var(--primary-color);
}

/* Common Section Padding (Applied to most sections) */
.home-section,
.about-section,
.homepagenewsblog,
.blog-wrapper,
.review-section,
.portfolio-section {
  padding: 80px 10%;
}
/* Adjust padding for specific elements that have it defined elsewhere */
.home-section {
  padding: 8% 10%;
}
.portfolio-section {
  padding: 1rem 2rem;
}
.review-section {
  padding-bottom: 100px;
  padding-top: 2px;
}

/* ----------------------------------------- */
/* MEDIA QUERIES FOR RESPONSIVENESS          */
/* ----------------------------------------- */

/* Large tablets (<= 1024px) */
@media (max-width: 1024px) {
  :root {
    --font-xl: 3rem;
    --font-lg: 1.8rem;
    --font-md: 0.95rem;
  }

  .home-section,
  .about-section,
  .homepagenewsblog,
  .blog-wrapper,
  .review-section,
  .portfolio-section {
    padding: 70px 8%;
  }
}

/* Tablets (<= 768px) */
@media (max-width: 768px) {
  :root {
    --font-xl: 2.5rem;
    --font-lg: 1.5rem;
    --font-md: 0.9rem;
  }

  .home-section,
  .about-section,
  .homepagenewsblog,
  .blog-wrapper,
  .review-section,
  .portfolio-section {
    padding: 60px 6%;
  }
}

/* Mobile (<= 480px) */
@media (max-width: 480px) {
  :root {
    --font-xl: 2rem;
    --font-lg: 1.2rem;
    --font-md: 0.85rem;
    --font-sm: 0.8rem;
  }

  html,
  body {
    font-size: 14px;
  }

  .home-section,
  .about-section,
  .homepagenewsblog,
  .blog-wrapper,
  .review-section,
  .portfolio-section {
    padding: 50px 5%;
    padding-bottom: 0px !important;
  }
}
/* ======================================================= */
/* === Scroll Progress Line (BrandAppart Style) === */
/* ======================================================= */

.scroll-line {
  position: fixed;
  right: 40px;
  top: 20%;
  bottom: 20%;
  width: 2px;
  background-color: #eaeaea;
  border-radius: 2px;
  z-index: 9999;
  overflow: hidden;
}

.scroll-dot {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  width: 10px;
  height: 10px;
  background-color: #000;
  border: 2px solid #fff;
  border-radius: 50%;
  transition: top 0.2s ease-out;
}

/* ========================================================== */
/* SIDEBAR (Minimal) */
/* ========================================================== */
/* ========================================================== */
/* SIDEBAR (Minimal) */
/* ========================================================== */
/* ========================================================== */
/* SIDEBAR (Minimal) - MODIFIED FOR BOTTOM SLIDE-IN TEXT */
/* ========================================================== */
.sidebar-minimal {
  width: 100px;
  min-height: 100vh;
  background-color: transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: fixed;
  top: 0;
  left: 0;
  padding-top: 1rem;
  z-index: 900;
  transition: left 0.4s ease;
}

.nav-icons {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-grow: 1;
  gap: 0.5rem;
  width: 100%;
}

.icon-box {
  width: 45px;
  height: 45px;
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
  border-radius: 10px;
  border: 1px solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1),
    inset 0 1px 0 rgba(255, 255, 255, 0.5),
    inset 0 -1px 0 rgba(255, 255, 255, 0.1),
    inset 0 0 0px 0px rgba(255, 255, 255, 0);
  position: relative;
  overflow: visible;
  opacity: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-dark);
  cursor: pointer;
  transition: all 0.3s ease;
}

.icon-box:hover {
  width: 80px;
  height: 80px;
  transform: translateY(-3px);
}

.icon-box i {
  font-size: 20px;
}

.contact-text {
  position: absolute;
  bottom: -30px;
  left: 50%;
  transform: translateX(-50%) translateY(0);
  opacity: 0;
  padding: 6px 12px;
  border-radius: 10px;
  font-size: 0.9rem;
  background-color: transparent;
  color: var(--text-light);
  white-space: nowrap;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  pointer-events: none;
  transition: all 0.3s ease;
  z-index: 1001;
}

.icon-box:hover .contact-text {
  opacity: 1;
  transform: translateX(-50%) translateY(-15px);
  bottom: -15px;
}
@media (max-width: 576px) {
  .menu-icon {
    display: block;

    z-index: 2000;
    top: 0; /* ✅ makes it visible on mobile */
  }

  .top-links {
    display: none; /* hide buttons in mobile view */
  }

  .sidebar-minimal {
    position: fixed;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100vh;
    min-height: auto;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    /* padding: 0; */
    /* background: rgba(0, 0, 0, 0.8); */
    backdrop-filter: blur(15px);
    border: none;
    transition: left 0.4s ease;
    z-index: 1100;
  }

  .sidebar-minimal.open {
    left: 0;
  }

  .nav-icons {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    width: 100%;
  }

  .icon-box {
    width: 65% !important;
    height: 10%;
    border: 4px solid white !important;
    text-decoration: none !important;
    border-width: 3px 3px 5px 5px;
    border-radius: 4% 95% 6% 95%/95% 4% 92% 5%;

    background: rgba(255, 255, 255, 0.05);

    box-shadow: none;

    /* background:transparent !important; */
    /* border: 1px solid rgba(255, 255, 255, 0.2); */
  }
  .icon-box i {
    /* display: none; */

    color: white !important;
  }
  .contact-text {
    display: block;
    color: white !important;
    position: static;
    opacity: 1;
    transform: none;
    /* margin-top: 8px; */
    font-size: 1.8rem !important;
  }

  .top-links {
    display: none;
  }

  .menu-overlay {
    display: block;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background: rgba(0, 0, 0, 0.4);
    z-index: 999;
  }
}

/* ========================================================== */
/* TOP NAVBAR */
/* ========================================================== */
/* ================= CSS ================= */
.top-navbar {
  position: fixed;
  top: 0;
  left: 0; /* start from the very left */
  width: 100%; /* full width */
  height: 70px;
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(6px);
  border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: space-between; /* logo left, buttons right */
  padding: 0 2rem; /* space on left/right */
  z-index: 999;
  transition: all 0.3s ease;
}

.top-logo h2 {
  margin: 0;
  font-size: 2.5rem;
  color: var(--text-dark);
  letter-spacing: 1px;
}

.top-links {
  display: flex;
  align-items: center;
}

.button-container {
  display: flex;
  gap: 1.5rem;
  align-items: center;
}

span.flip-button-wrapper {
  perspective: 1000px;
}

.flip-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 180px;
  height: 55px;
  font-size: 18px;
  letter-spacing: 1px;
  font-family: "Montserrat", sans-serif;
  text-decoration: none;
  color: #fff;
  cursor: pointer;
  transform-style: preserve-3d;
  transition: transform 0.35s ease;
  position: relative;
}

.flip-button::before,
.flip-button::after {
  content: attr(data-text);
  position: absolute;
  width: 180px;
  height: 55px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3px solid;
  border-radius: 5px;
  font-weight: 600;
  box-sizing: border-box;
}

.flip-button::before {
  background: #f84b4b;
  color: #fff;
  transform: rotateY(0deg) translateZ(25px);
}

.flip-button::after {
  background: #fff;
  color: #f84b4b;
  transform: rotateX(90deg) translateZ(25px);
}

.flip-button:hover {
  transform: translateZ(-25px) rotateX(-90deg);
}

/* ========================================================== */
/* MEDIA QUERIES - NAVBAR */
/* ========================================================== */
@media (max-width: 992px) {
  .top-navbar {
    left: 80px;
    width: calc(100% - 80px);
    height: 65px;
  }

  .top-logo h2 {
    font-size: 2rem;
  }

  .top-links {
    gap: 1rem;
  }

  .button-56 {
    font-size: 14px;
    padding: 0.25em 0.45em;
  }
}

@media (max-width: 768px) {
  .top-navbar {
    position: absolute;
    left: 60px;
    width: calc(100% - 60px);
    height: 60px;
    padding: 0 10px;
  }

  .top-logo h2 {
    font-size: 1.7rem;
  }

  .top-links {
    gap: 0.8rem;
  }

  .button-56 {
    font-size: 13px;
    padding: 0.2em 0.4em;
    border-width: 2px;
    box-shadow: 1px 1px 0px 0px, 2px 2px 0px 0px, 3px 3px 0px 0px;
  }
}

@media (max-width: 576px) {
  .top-navbar {
    left: 0;
    width: 100%;
    height: 55px;
    justify-content: space-between;
    padding: 0 12px;
  }

  .top-logo h2 {
    font-size: 1.4rem;
    letter-spacing: 0.5px;
  }

  .top-links {
    display: none;
  }

  .top-link {
    font-size: 0.5rem;
    padding: 0px 1px;
  }

  .button-56 {
    font-size: 11px;
    padding: 0.18em 0.35em;
    border-width: 2px;
    box-shadow: 1px 1px 0px 0px, 2px 2px 0px 0px;
  }
}

/* ========================================================== */
/* MOBILE MENU ICON */
/* ========================================================== */
.menu-icon {
  display: none;
  font-size: 1.8rem;
  color: var(--text-dark);
  cursor: pointer;
  margin-right: 15px;
  transition: transform 0.3s ease;
}

.menu-icon:active {
  transform: scale(0.9);
}
@media (max-width: 768px) {
  .menu-icon {
    display: block !important;
  }
}
/* ========================================================== */
/* HERO SECTION */
/* ========================================================== */
.home-section {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  text-align: left;
  background: var(--background-light);
  overflow: hidden;
  gap: 5%;
}

.outside {
  flex: 1;
  max-width: 600px;
  z-index: 2;
}

/* HERO TEXT */
.hero h1 {
  font-size: 4rem;
  line-height: 1.2;
  font-weight: 800;
  color: var(--text-dark);
  margin-bottom: 25px;
}

.subtext {
  font-size: 1.4rem;
  color: var(--text-light);
  margin-bottom: 40px;
  line-height: 1.8;
  max-width: 600px;
}

/* HERO IMAGE - on right */
.imgin {
  flex: 1;
  width: 450px;
  max-width: 100%;
  animation: float 4s ease-in-out infinite;

  z-index: 1;
}

@keyframes float {
  0% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-15px);
  }
  100% {
    transform: translateY(0);
  }
}

/* ========================================================== */
/* MARQUEE ANIMATION */
/* ========================================================== */
.marquee {
  overflow: hidden;
  white-space: nowrap;
  border-top: 1px solid #ccc;
  border-bottom: 1px solid #ccc;
  margin: 40px 0;
  padding: 12px 0;
  color: var(--primary-color);
  font-weight: 500;
}

.marquee-inner {
  display: inline-block;
  animation: marquee 12s linear infinite;
}

.marquee-inner span {
  margin-right: 50px;
  font-size: 1.2rem;
  letter-spacing: 1px;
}

@keyframes marquee {
  0% {
    transform: translateX(0%);
  }
  100% {
    transform: translateX(-50%);
  }
}

/* ========================================================== */
/* INTRO TEXT & CTA BUTTON */
/* ========================================================== */
.intro p {
  font-size: 1.2rem;
  line-height: 1.8;
  color: var(--text-light);
  margin-bottom: 25px;
}

.cta-btn {
  background-color: var(--primary-color);
  color: var(--background-white);
  border: none;
  padding: 15px 30px;
  border-radius: 50px;
  font-size: 1.2rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
}

.cta-btn i {
  margin-left: 10px;
}

.cta-btn:hover {
  background-color: var(--primary-color);
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(255, 107, 0, 0.4);
}
/* ----------------------------------------- */
/* MEDIA QUERIES FOR HERO SECTION & MARQUEE  */
/* ----------------------------------------- */

/* Large tablets (<= 1024px) */
@media (max-width: 1024px) {
  .hero h1 {
    font-size: 3.2rem;
  }

  .subtext {
    font-size: 1.2rem;
    max-width: 500px;
  }

  .imgin {
    width: 380px;
  }

  .cta-btn {
    font-size: 1.1rem;
    padding: 12px 25px;
  }
}

/* Tablets (<= 768px) */
@media (max-width: 768px) {
  .home-section {
    flex-direction: column-reverse;
    text-align: center;
    justify-content: center;
    gap: 2rem;
    padding: 60px 6%;
  }

  .outside {
    max-width: 100%;
  }

  .hero h1 {
    font-size: 2.6rem;
  }

  .subtext {
    font-size: 1.1rem;
    margin-bottom: 30px;
  }

  .imgin {
    width: 320px;
    animation: float 5s ease-in-out infinite;
  }

  .cta-btn {
    font-size: 1rem;
    padding: 12px 24px;
  }

  .marquee-inner span {
    font-size: 1rem;
    margin-right: 30px;
  }
}

/* Mobile (<= 480px) */
@media (max-width: 480px) {
  .home-section {
    flex-direction: column-reverse;
    text-align: center;
    gap: 1.5rem;
    padding: 50px 5%;
  }

  .hero h1 {
    font-size: 2rem;
    line-height: 1.3;
  }

  .subtext {
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 25px;
  }

  .imgin {
    width: 250px;
  }

  .cta-btn {
    font-size: 0.95rem;
    padding: 10px 22px;
    border-radius: 40px;
  }

  .marquee {
    margin: 30px 0;
    padding: 8px 0;
  }

  .marquee-inner span {
    font-size: 0.9rem;
    margin-right: 20px;
  }
}









