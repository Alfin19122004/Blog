    .cards {
      display: grid;
      place-items: center;
      position: relative;
      /* Max width adjustment for responsiveness */
      width: min(100% - 2rem, 800px);
      /* This height keeps the card area centered */
      height: 450px; 
      margin-inline: auto;
      margin-top: 20px;
    }
    
    /* Hide radios */
    input[type="radio"] {
      position: absolute;
      opacity: 0;
    }
    
    /* ===== Card Base ===== */
    .card {
      position: absolute;
      inset: 0;
      grid-area: 1 / 1;
      display: grid;
      place-items: center;
