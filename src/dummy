        align-items: center;
      }
      .card-data p {
        max-width: 90%;
        margin-inline: auto;
      }
      .card-data footer {
     
        justify-content: center;
      }
      .card-img {
        width: 150px;
        height: 150px;
        min-width: 150px;
      }
    } 

