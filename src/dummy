/* HERO IMAGE - on right */
.imgin {
  flex: 1;
  width: 450px;
  max-width: 100%;
  animation: float 4s ease-in-out infinite;
margin-top: 100px;
  z-index: 1;
}

@keyframes float {
  0% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-15px);
  }
  100% {
    transform: translateY(0);
  }
}

/* ========================================================== */
/* MARQUEE ANIMATION */
/* ========================================================== */
.marquee {
  overflow: hidden;
  white-space: nowrap;
  border-top: 1px solid #ccc;
  border-bottom: 1px solid #ccc;
  margin: 40px 0;
  padding: 12px 0;
  color: var(--text-dark);
  font-weight: 500;
}

.marquee-inner {
  display: inline-block;
  animation: marquee 12s linear infinite;
}

.marquee-inner span {
  margin-right: 50px;
  font-size: 1.2rem;
  letter-spacing: 1px;
}

@keyframes marquee {
  0% {
    transform: translateX(0%);
  }
  100% {
    transform: translateX(-50%);
  }
}

