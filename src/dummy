      /* box-shadow: 0 16px 32px rgba(0, 0, 0, 0.1);  */
      opacity: 0;
      transform: translateY(50px) scale(0.9);
    }
    
    input:checked + .card {
      z-index: 10;
      opacity: 1;
      transform: translateY(0) scale(1); /* Removed aggressive scale for smoother look */
      background:transparent;
