    .carousel-title {
      font-size: 2.5rem;
      font-weight: 800;
      background: linear-gradient(120deg, var(--primary-color), #333333);
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
      margin-bottom: 50px;
      padding: 0 10px;
      line-height: 1.2;
    }
    .carousel-title span {
      color: var(--primary-color);
    }
    
